{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TOOBIX Impact Event Schema",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "match_id": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "verification": {
      "type": "object",
      "properties": {
        "level": { "type": "string" },
        "receiver_confirmed": { "type": "boolean" },
        "giver_confirmed": { "type": "boolean" },
        "external_evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "outcome": { "type": "string" },
    "ai_life_proposal": { "type": "number" },
    "final_life": { "type": "number" },
    "receiver_credit": { "type": "number" },
    "giver_credit": { "type": "number" },
    "commons_impact": { "type": "number" },
    "community_dividend": { "type": "number" },
    "audit": {
      "type": "object",
      "properties": {
        "constitution_version": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "required": ["id", "match_id", "final_life", "receiver_credit", "giver_credit", "commons_impact"]
}
