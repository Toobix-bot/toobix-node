{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://toobix.org/schemas/balance-node.schema.json",
  "title": "TOOBIX World Balance Node",
  "description": "Ein general-purpose Modell fuer Beduerfnisse, Ressourcen und Luecken eines Knotenpunkts (Community, Stadt, Land etc.).",
  "type": "object",
  "required": ["scope", "relations"],
  "properties": {
    "scope": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "community",
            "neighborhood",
            "city",
            "district",
            "region",
            "health-region",
            "state",
            "country",
            "continent",
            "world"
          ]
        },
        "name": {
          "type": "string"
        },
        "codes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["within", "serves", "overlaps", "borders", "depends_on"]
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "need_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Referenzen auf TOOBIX Needs (URNs)"
    },
    "resource_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Referenzen auf TOOBIX Resources/Capacities (Krankenhaeuser, Budgets etc.)"
    },
    "gap_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "severity", "basis", "reason"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["absolute scarcity", "access/distribution", "coordination", "interest conflict"]
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "basis": {
            "type": "string",
            "enum": ["derived", "reported", "measured"]
          },
          "need_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "resource_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          }
        }
      }
    },
    "risk_observations": {
      "type": "object",
      "properties": {
        "pressure": { "type": "object" },
        "vulnerability": { "type": "object" },
        "capacity": { "type": "object" },
        "external_metrics": {
          "type": "object",
          "description": "Mapping externer Risikoindizes (z.B. INFORM Risk), ohne die native TOOBIX-Sprache zu veraendern."
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["confidence"],
      "properties": {
        "confidence": {
          "type": "string",
          "enum": ["unknown", "low", "medium", "high"]
        },
        "freshness": {
          "type": "string",
          "enum": ["current", "outdated", "historical"]
        },
        "coverage": {
          "type": "string",
          "enum": ["sparse", "partial", "comprehensive"]
        },
        "source_count": {
          "type": "integer"
        },
        "observed_at": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "references": {
      "type": "object",
      "properties": {
        "sdg": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
